#!/usr/bin/env bash
# Fast, staged-files-only gate. The full suite runs in pre-push instead —
# see CODE_STANDARDS.md for why the split. Installed via
# `bash tool/install_hooks.sh` (sets core.hooksPath to this directory).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged_dart_files() {
  git diff --cached --name-only --diff-filter=ACM -- '*.dart'
}

mapfile -t dart_files < <(staged_dart_files)

if [ "${#dart_files[@]}" -gt 0 ]; then
  echo "==> dart format (staged files)"
  dart format "${dart_files[@]}"
  git add -- "${dart_files[@]}"
fi

echo "==> tool/check_architecture.dart"
dart run tool/check_architecture.dart

echo "==> scanning staged diff for secrets"
secret_pattern='(-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|(password|secret|api[_-]?key|token)[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"']{8,})'
added_lines="$(git diff --cached -U0 -- . ':!*.lock' | grep -E '^\+' | grep -viE '^\+\+\+' || true)"
matches="$(printf '%s\n' "$added_lines" | grep -EiI "$secret_pattern" || true)"
if [ -n "$matches" ]; then
  echo "✖ possible secret found in staged changes:"
  echo "$matches"
  echo "Remove it and, if it was ever committed before, rotate the credential."
  exit 1
fi

echo "==> pre-commit checks passed"
